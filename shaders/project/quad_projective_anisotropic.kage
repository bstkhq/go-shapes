//kage:unit pixels
package main

// NOTE: this version uses anisotropic-style offsets taken from dfdx/dfdy
//       in order to improve texture stability, but requires 8 samples (two
//       bilinear lookups) in order to avoid jaggies.

var Homography mat3
var DstSampling int

func Fragment(targetCoords vec4, _ vec2, color vec4, customVAs vec4) vec4 {
	relCoords := targetCoords.xy - imageDstOrigin()

	uvw := Homography * vec3(relCoords, 1.0)
	uv := uvw.xy / uvw.z

	texPos := imageSrc0Origin() + uv*imageSrc0Size()

	dPdx := dfdx(uv) * imageSrc0Size()
	dPdy := dfdy(uv) * imageSrc0Size()

	offset := majorAxis(dPdx, dPdy) * 0.25
	var c1, c2 vec4
	if DstSampling == 1 {
		filterWidth := clamp(abs(dPdx)+abs(dPdy), vec2(0.001), vec2(1))
		c1 = clampedDstBilinear0(texPos-offset, filterWidth)
		c2 = clampedDstBilinear0(texPos+offset, filterWidth)
	} else {
		c1 = clampedSrcBilinear0(texPos - offset)
		c2 = clampedSrcBilinear0(texPos + offset)
	}
	out := (c1 + c2) * 0.5
	return mix(out, color*out, customVAs[0])
}

// majorAxis points in the direction where the texture is most compressed.
// Its length is how compressed it is: 1 means no compression, 2 means each
// screen pixel covers two texture pixels in that direction.
func majorAxis(dx, dy vec2) vec2 {
	a, b, c := dot(dx, dx), dot(dx, dy), dot(dy, dy)
	d := a - c
	h := sqrt(d*d + 4.0*b*b)
	v := vec2(h+d, 2.0*b) // both forms are parallel,
	if d < 0 {            // pick the numerically stable one
		v = vec2(2.0*b, h-d)
	}
	vv := dot(v, v)
	if vv < 1e-12 {
		return dx // isotropic, any direction works
	}
	return (dx*v.x + dy*v.y) * inversesqrt(vv)
}

func clampedSrcBilinear0(coords vec2) vec4 {
	loPixIndex, hiPixIndex, blend := srcBilinearIndicesAndBlend(coords)
	return clampedRawBilinear0(loPixIndex, hiPixIndex, blend)
}

func clampedDstBilinear0(coords, filterWidth vec2) vec4 {
	loPixIndex, hiPixIndex, blend := dstBilinearIndicesAndBlend(coords, filterWidth)
	return clampedRawBilinear0(loPixIndex, hiPixIndex, blend)
}

func clampedRawBilinear0(loPixIndex, hiPixIndex, blend vec2) vec4 {
	loPixIndex, hiPixIndex = clampSourcePixelIndices(loPixIndex, hiPixIndex)
	tl := imageSrc0UnsafeAt(loPixIndex)
	tr := imageSrc0UnsafeAt(vec2(hiPixIndex.x, loPixIndex.y))
	bl := imageSrc0UnsafeAt(vec2(loPixIndex.x, hiPixIndex.y))
	br := imageSrc0UnsafeAt(hiPixIndex)
	return bilinearMix(tl, tr, bl, br, blend)
}

func srcBilinearIndicesAndBlend(coords vec2) (vec2, vec2, vec2) {
	lower := coords - vec2(0.5)
	loPixIndex := floor(lower)
	return loPixIndex, loPixIndex + vec2(1), lower - loPixIndex
}

// precondition: 0 < filterWidth <= 1 on each axis, in source pixels
func dstBilinearIndicesAndBlend(coords, filterWidth vec2) (vec2, vec2, vec2) {
	pixel := floor(coords)
	nearestEdge := pixel + step(pixel+vec2(0.5), coords)     // nearestEdge of pix containing coords
	edgeDistInWidths := (coords - nearestEdge) / filterWidth // signed distance
	blend := clamp(vec2(0.5)+edgeDistInWidths, 0, 1)         // weight of the pixel past nearestEdge
	return nearestEdge - vec2(1), nearestEdge, blend
}

func clampSourcePixelIndices(loPixIndex, hiPixIndex vec2) (vec2, vec2) {
	minIndex := imageSrc0Origin()
	maxIndex := minIndex + imageSrc0Size() - vec2(1)
	return clamp(loPixIndex, minIndex, maxIndex), clamp(hiPixIndex, minIndex, maxIndex)
}

func bilinearMix(tl, tr, bl, br vec4, delta vec2) vec4 {
	top := mix(tl, tr, delta.x)
	bottom := mix(bl, br, delta.x)
	return mix(top, bottom, delta.y)
}
