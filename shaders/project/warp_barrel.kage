//kage:unit pixels
package main

// NOTE: the mapping is x' = x(1 + wx*y^2), y' = y(1 + wy*x^2), in centered
// normalized coordinates.
//
// Anisotropic sampling was evaluated and rejected. The approach: take the
// jacobian of the mapping above (scaled to pixels by the image aspect), find
// its major axis with majorAxis() from quad_projective_anisotropic.kage, and
// average two bilinear taps at ±0.33 along it as in warp_arc.kage, fading
// the spread in between 1.0 and 1.3 source pixels per destination pixel so
// that nearly 1:1 areas stay sharp.
//
// The warp compresses the source by at most ~1.75 (warp 1.5 on both axes), so
// moiré stays small. Over scrolling 1px scanlines, with the horizontal warp
// at half the vertical one as in TestWarpBarrel, it measured under one 8-bit
// level per frame up to warp 1.0 and ~1.6 at warp 1.5. The taps cut it by
// about a third, but visibly soften the image. What it saves is harder to see
// than the softening it causes.

func Fragment(_ vec4, sourceCoords vec2, _ vec4, customVAs vec4) vec4 {
	warp := customVAs.xy // horz and vertical warp factors

	normSourceCoords := (sourceCoords - imageSrc0Origin()) / imageSrc0Size()
	origSourceCoords := normSourceCoords - vec2(0.5)
	warpQuadr := square(abs(origSourceCoords.yx))
	origSourceCoords *= vec2(1.0) + warpQuadr*warp
	normSourceCoords = origSourceCoords + vec2(0.5)

	finalCoords := normSourceCoords*imageSrc0Size() + imageSrc0Origin()
	return srcBilinear0(finalCoords)
}

func square(v vec2) vec2 {
	return v * v
}

func srcBilinear0(coords vec2) vec4 {
	loPixIndex, hiPixIndex, blend := srcBilinearIndicesAndBlend(coords)
	tl := imageSrc0At(loPixIndex)
	tr := imageSrc0At(vec2(hiPixIndex.x, loPixIndex.y))
	bl := imageSrc0At(vec2(loPixIndex.x, hiPixIndex.y))
	br := imageSrc0At(hiPixIndex)
	return bilinearMix(tl, tr, bl, br, blend)
}

func srcBilinearIndicesAndBlend(coords vec2) (vec2, vec2, vec2) {
	lower := coords - vec2(0.5)
	loPixIndex := floor(lower)
	return loPixIndex, loPixIndex + vec2(1), lower - loPixIndex
}

func bilinearMix(tl, tr, bl, br vec4, delta vec2) vec4 {
	top := mix(tl, tr, delta.x)
	bottom := mix(bl, br, delta.x)
	return mix(top, bottom, delta.y)
}
