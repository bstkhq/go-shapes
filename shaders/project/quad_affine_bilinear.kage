//kage:unit pixels
package main

var DstSampling int

func Fragment(_ vec4, sourceCoords vec2, color vec4, customVAs vec4) vec4 {
	var out vec4
	if DstSampling == 1 {
		dstPixSize := abs(dfdx(sourceCoords)) + abs(dfdy(sourceCoords))
		filterWidth := clamp(dstPixSize, vec2(1e-30), vec2(1))
		loPixIndex, hiPixIndex, blend := dstBilinearIndicesAndBlend(sourceCoords, filterWidth)
		out = clampedRawBilinear0(loPixIndex, hiPixIndex, blend)
	} else {
		loPixIndex, hiPixIndex, blend := srcBilinearIndicesAndBlend(sourceCoords)
		out = clampedRawBilinear0(loPixIndex, hiPixIndex, blend)
	}
	return mix(out, color*out, customVAs[0])
}

func clampedRawBilinear0(loPixIndex, hiPixIndex, blend vec2) vec4 {
	loPixIndex, hiPixIndex = clampSourcePixelIndices(loPixIndex, hiPixIndex)
	tl := imageSrc0UnsafeAt(loPixIndex)
	tr := imageSrc0UnsafeAt(vec2(hiPixIndex.x, loPixIndex.y))
	bl := imageSrc0UnsafeAt(vec2(loPixIndex.x, hiPixIndex.y))
	br := imageSrc0UnsafeAt(hiPixIndex)
	return bilinearMix(tl, tr, bl, br, blend)
}

func srcBilinearIndicesAndBlend(coords vec2) (vec2, vec2, vec2) {
	lower := coords - vec2(0.5)
	loPixIndex := floor(lower)
	return loPixIndex, loPixIndex + vec2(1), lower - loPixIndex
}

// precondition: 0 < filterWidth <= 1 on each axis, in source pixels
func dstBilinearIndicesAndBlend(coords, filterWidth vec2) (vec2, vec2, vec2) {
	nearestEdge := floor(coords + vec2(0.5))                 // can round up to the next edge, which blend's clamp absorbs
	edgeDistInWidths := (coords - nearestEdge) / filterWidth // signed distance
	blend := clamp(vec2(0.5)+edgeDistInWidths, 0, 1)         // weight of the pixel past nearestEdge
	return nearestEdge - vec2(1), nearestEdge, blend
}

func clampSourcePixelIndices(loPixIndex, hiPixIndex vec2) (vec2, vec2) {
	minIndex := imageSrc0Origin()
	maxIndex := minIndex + imageSrc0Size() - vec2(1)
	return clamp(loPixIndex, minIndex, maxIndex), clamp(hiPixIndex, minIndex, maxIndex)
}

func bilinearMix(tl, tr, bl, br vec4, delta vec2) vec4 {
	top := mix(tl, tr, delta.x)
	bottom := mix(bl, br, delta.x)
	return mix(top, bottom, delta.y)
}
