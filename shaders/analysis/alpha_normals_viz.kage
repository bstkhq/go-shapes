//kage:unit pixels
package main

// Visualizes an alpha normals map (see alpha_normals.kage): hue shows the
// alpha descent direction, and brightness the side of the boundary the pixel
// center is on (bright on the high alpha side, dim on the low one). Pixels
// without data stay transparent.

func Fragment(_ vec4, sourceCoords vec2, _ vec4, _ vec4) vec4 {
	data := imageSrc0At(sourceCoords)
	if data.a == 0 {
		return vec4(0)
	}

	descent := normalize(data.rg*2.0 - 1.0) // 8-bit components, normalize again
	offset := (data.b - 0.5) * 1.5
	const Tau = 6.28318531
	hue := atan2(descent.y, descent.x)/Tau + 0.5
	rgb := clamp(abs(fract(hue+vec3(0, 2.0/3.0, 1.0/3.0))*6.0-3.0)-1.0, 0, 1)
	brightness := 0.35 + 0.65*clamp(0.5-offset/1.5, 0, 1)
	return vec4(rgb*brightness, 1)
}
