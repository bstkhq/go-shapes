//kage:unit pixels
package main

var Bilinear int

func Fragment(_ vec4, sourceCoords vec2, _ vec4, customVAs vec4) vec4 {
	dstPixSize, reveal := customVAs.xy, customVAs.z
	relCoords := sourceCoords - imageSrc0Origin()
	maskCoords := relCoords*dstPixSize + imageSrc0Origin()

	var srcColor vec4
	var maskAlpha float
	if Bilinear == 1 {
		srcColor = bilinearSampling0(sourceCoords)
		maskAlpha = clampedDstBilinear1(maskCoords, dstPixSize).a
	} else {
		srcColor = imageSrc0UnsafeAt(sourceCoords)
		// floor to reduce precision issues before ebitengine v2.11, see github.com/hajimehoshi/ebiten/issues/3865
		maskAlpha = imageSrc1At(floor(maskCoords)).a
	}

	gate := step(maskAlpha, reveal)
	return srcColor * gate
}

func bilinearSampling0(coords vec2) vec4 {
	loPixIndex, hiPixIndex, blend := bilinearIndicesAndBlend(coords)
	tl := imageSrc0At(loPixIndex)
	tr := imageSrc0At(vec2(hiPixIndex.x, loPixIndex.y))
	bl := imageSrc0At(vec2(loPixIndex.x, hiPixIndex.y))
	br := imageSrc0At(hiPixIndex)
	return bilinearMix(tl, tr, bl, br, blend)
}

func bilinearIndicesAndBlend(coords vec2) (vec2, vec2, vec2) {
	lower := coords - vec2(0.5)
	loPixIndex := floor(lower)
	return loPixIndex, loPixIndex + vec2(1), lower - loPixIndex
}

func clampedDstBilinear1(coords, dstPixSize vec2) vec4 {
	loPixIndex, hiPixIndex, blend := dstBilinearIndicesAndBlend(coords, min(dstPixSize, vec2(1)))
	loPixIndex, hiPixIndex = clampMaskPixelIndices(loPixIndex, hiPixIndex)
	tl := imageSrc1UnsafeAt(loPixIndex)
	tr := imageSrc1UnsafeAt(vec2(hiPixIndex.x, loPixIndex.y))
	bl := imageSrc1UnsafeAt(vec2(loPixIndex.x, hiPixIndex.y))
	br := imageSrc1UnsafeAt(hiPixIndex)
	return bilinearMix(tl, tr, bl, br, blend)
}

// precondition: 0 < filterWidth <= 1 on each axis, in source pixels
func dstBilinearIndicesAndBlend(coords, filterWidth vec2) (vec2, vec2, vec2) {
	pixel := floor(coords)
	nearestEdge := pixel + step(pixel+vec2(0.5), coords)     // nearestEdge of pix containing coords
	edgeDistInWidths := (coords - nearestEdge) / filterWidth // signed distance
	blend := clamp(vec2(0.5)+edgeDistInWidths, 0, 1)         // weight of the pixel past nearestEdge
	return nearestEdge - vec2(1), nearestEdge, blend
}

// without clamping, transparent pixels would lower the reveal threshold
func clampMaskPixelIndices(loPixIndex, hiPixIndex vec2) (vec2, vec2) {
	minIndex := imageSrc0Origin()
	maxIndex := minIndex + imageSrc1Size() - vec2(1)
	return clamp(loPixIndex, minIndex, maxIndex), clamp(hiPixIndex, minIndex, maxIndex)
}

func bilinearMix(tl, tr, bl, br vec4, delta vec2) vec4 {
	top := mix(tl, tr, delta.x)
	bottom := mix(bl, br, delta.x)
	return mix(top, bottom, delta.y)
}
