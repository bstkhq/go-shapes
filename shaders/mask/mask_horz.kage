//kage:unit pixels
package main

var Bilinear int
var Dither int

func Fragment(targetCoords vec4, sourceCoords vec2, _ vec4, customVAs vec4) vec4 {
	var srcColor vec4
	if Bilinear == 1 {
		srcColor = bilinearSampling0(sourceCoords)
	} else {
		srcColor = imageSrc0UnsafeAt(sourceCoords)
	}

	lo, hi, ltr := customVAs[0], customVAs[1], customVAs[2]
	relCoords := targetCoords.xy - imageDstOrigin()
	out := srcColor * abs(ltr-smoothstep(lo, hi, relCoords.x)) // ltr = +smoothstep, rtl = 1.0 - smoothstep

	if Dither == 1 {
		noise := imageSrc1UnsafeAt(mod(relCoords, vec2(64)) + imageSrc0Origin()).r
		out.rgb += vec3((noise - 0.5) / 255.0)
		out.rgb = clamp(out.rgb, vec3(0.0), vec3(out.a))
	}

	return out
}

func bilinearSampling0(coords vec2) vec4 {
	loPixIndex, hiPixIndex, blend := bilinearIndicesAndBlend(coords)
	tl := imageSrc0At(loPixIndex)
	tr := imageSrc0At(vec2(hiPixIndex.x, loPixIndex.y))
	bl := imageSrc0At(vec2(loPixIndex.x, hiPixIndex.y))
	br := imageSrc0At(hiPixIndex)
	return bilinearMix(tl, tr, bl, br, blend)
}

func bilinearIndicesAndBlend(coords vec2) (vec2, vec2, vec2) {
	lower := coords - vec2(0.5)
	loPixIndex := floor(lower)
	return loPixIndex, loPixIndex + vec2(1), lower - loPixIndex
}

func bilinearMix(tl, tr, bl, br vec4, delta vec2) vec4 {
	top := mix(tl, tr, delta.x)
	bottom := mix(bl, br, delta.x)
	return mix(top, bottom, delta.y)
}
