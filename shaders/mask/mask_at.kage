//kage:unit pixels
package main

var Bilinear int
var Dither int

func Fragment(targetCoords vec4, sourceCoords vec2, _ vec4, customVAs vec4) vec4 {
	maskOffset := customVAs.xy

	var srcColor vec4
	var maskAlpha float
	if Bilinear == 1 {
		srcColor = srcBilinear0(sourceCoords)
		maskAlpha = srcBilinear1(sourceCoords + maskOffset).a
	} else {
		srcColor = imageSrc0UnsafeAt(sourceCoords)
		// floor to reduce precision issues, see github.com/hajimehoshi/ebiten/issues/3865
		maskAlpha = imageSrc1At(floor(sourceCoords + maskOffset)).a
	}
	out := srcColor * maskAlpha

	if Dither == 1 {
		relCoords := targetCoords.xy - imageDstOrigin()
		noise := imageSrc2UnsafeAt(mod(relCoords, vec2(64)) + imageSrc0Origin()).r
		out.rgb += vec3((noise - 0.5) / 255.0)
		out.rgb = clamp(out.rgb, vec3(0.0), vec3(out.a))
	}

	return out
}

func srcBilinear0(coords vec2) vec4 {
	loPixIndex, hiPixIndex, blend := srcBilinearIndicesAndBlend(coords)
	tl := imageSrc0At(loPixIndex)
	tr := imageSrc0At(vec2(hiPixIndex.x, loPixIndex.y))
	bl := imageSrc0At(vec2(loPixIndex.x, hiPixIndex.y))
	br := imageSrc0At(hiPixIndex)
	return bilinearMix(tl, tr, bl, br, blend)
}

func srcBilinear1(coords vec2) vec4 {
	loPixIndex, hiPixIndex, blend := srcBilinearIndicesAndBlend(coords)
	tl := imageSrc1At(loPixIndex)
	tr := imageSrc1At(vec2(hiPixIndex.x, loPixIndex.y))
	bl := imageSrc1At(vec2(loPixIndex.x, hiPixIndex.y))
	br := imageSrc1At(hiPixIndex)
	return bilinearMix(tl, tr, bl, br, blend)
}

func srcBilinearIndicesAndBlend(coords vec2) (vec2, vec2, vec2) {
	lower := coords - vec2(0.5)
	loPixIndex := floor(lower)
	return loPixIndex, loPixIndex + vec2(1), lower - loPixIndex
}

func bilinearMix(tl, tr, bl, br vec4, delta vec2) vec4 {
	top := mix(tl, tr, delta.x)
	bottom := mix(bl, br, delta.x)
	return mix(top, bottom, delta.y)
}
