//kage:unit pixels
package main

// First pass of MorphExpansionRect, vertical: each pixel takes the highest
// alpha found within thickness above or below it. Second pass does the same
// but horizontally and applying vertex colors.
//
// Pixels whose centers fall within the thickness window count fully. At the
// window's start and end, instead, alpha is interpolated from the two pixels
// on either side, as if alpha changed linearly from one pixel center to the
// next. This makes edges move smoothly as thickness and draw position change.

func Fragment(_ vec4, sourceCoords vec2, _ vec4, customVAs vec4) vec4 {
	const MaxThickness = 32.0
	const MaxSamples = MaxThickness*2.0 + 3.0

	thickness := customVAs[0]
	x := sourceCoords.x
	windowStart, windowEnd := sourceCoords.y-thickness, sourceCoords.y+thickness

	// pixel indices to interpolate at the window limits. beforeStart is the
	// last pixel with its center <= window start, and afterEnd the first pixel
	// with its center > window end
	beforeStart := floor(windowStart - 0.5)
	afterEnd := floor(windowEnd-0.5) + 1.0

	// interpolation factors at the window limits. notice that if the window
	// reaches the limit pixel centers, they get full contribution. no need for
	// the whole pixel to be contained. test thickness 0 and 1 to understand
	startInterp := windowStart - (beforeStart + 0.5)
	endInterp := windowEnd - (afterEnd - 0.5)

	// each pixel is read once, from beforeStart to afterEnd
	maxAlpha := 0.0
	prevAlpha := 0.0
	for i := 0.0; i < MaxSamples; i += 1.0 {
		pixel := beforeStart + i
		if pixel > afterEnd {
			break
		}
		pixAlpha := imageSrc0At(vec2(x, pixel+0.5)).a

		// start interpolation needs the first two pixels; the branch runs
		// separately because the current pixel can also be within the window,
		// or be afterEnd
		if pixel == beforeStart+1.0 {
			maxAlpha = max(maxAlpha, mix(prevAlpha, pixAlpha, startInterp))
		}
		if pixel == afterEnd { // only counts through the end interpolation
			maxAlpha = max(maxAlpha, mix(prevAlpha, pixAlpha, endInterp))
		} else if pixel > beforeStart { // within the window
			maxAlpha = max(maxAlpha, pixAlpha)
		}
		prevAlpha = pixAlpha
	}
	return vec4(maxAlpha)
}
