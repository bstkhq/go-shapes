//kage:unit pixels
package main

// along an axis, a source texel and destination pixel first touch when their
// centers are one pixel apart (0.5 + 0.5). the shader changes the texel's
// contribution gradually over that distance instead of switching it abruptly.
const SampleTransition = 1.0

// full pixel-coverage reconstruction was also tested. it projected the source
// and destination pixel squares onto the sample direction, giving a combined
// reach from 1.0 on an axis to sqrt(2) diagonally, and integrated a soft disk
// across that interval. it was slightly more stable at very low thicknesses,
// but also blurrier and considerably more expensive. the fixed transition used
// here underestimates diagonal coverage but is generally sharper.

func Fragment(targetCoords vec4, sourceCoords vec2, color vec4, customVAs vec4) vec4 {
	const MaxThickness = 16.0
	const ScanEpsilon = 0.001 // compatible with f32 atlas coords up to 32768
	const MaxSamples = MaxThickness + 4.0

	halfThick := customVAs[0] / 2.0
	softEdge := min(customVAs[1], halfThick)
	hardRadius := halfThick - softEdge
	// candidate centers beyond this distance have zero weight.
	scanReach := halfThick + SampleTransition

	firstTexel := ceil(sourceCoords-vec2(scanReach)-vec2(ScanEpsilon)) - vec2(1)
	lastTexel := floor(sourceCoords + vec2(scanReach+ScanEpsilon))
	sourceAlpha := imageSrc0At(sourceCoords).a
	expansionAlpha := sourceAlpha
	erosionAlpha := sourceAlpha

	for y := 0.0; y < MaxSamples; y += 1.0 {
		sampleYIndex := firstTexel.y + y
		if sampleYIndex > lastTexel.y {
			break
		}
		for x := 0.0; x < MaxSamples; x += 1.0 {
			sampleXIndex := firstTexel.x + x
			if sampleXIndex > lastTexel.x {
				break
			}

			sampleCoords := vec2(sampleXIndex, sampleYIndex) + vec2(0.5)
			dist := distance(sourceCoords, sampleCoords)
			weight := outlineSampleWeight(dist, hardRadius, halfThick)
			if weight > 0.0 {
				sampleAlpha := imageSrc0At(sampleCoords).a
				expansionAlpha = max(expansionAlpha, mix(sourceAlpha, sampleAlpha, weight))
				erosionAlpha = min(erosionAlpha, mix(sourceAlpha, sampleAlpha, weight))
			}
		}
	}

	return color * (expansionAlpha - erosionAlpha)
}

// outlineSampleWeight returns how strongly one source texel affects the current
// destination pixel. its zero-radius value is removed so the gradual transition
// between pixels doesn't create an outline of its own.
func outlineSampleWeight(distance, hardRadius, radius float) float {
	zeroRadiusWeight := 1.0 - smoothstep(0.0, SampleTransition, distance)
	if zeroRadiusWeight >= 1.0 {
		return 0.0
	}
	weight := 1.0 - smoothstep(hardRadius, radius+SampleTransition, distance)
	return clamp((weight-zeroRadiusWeight)/(1.0-zeroRadiusWeight), 0.0, 1.0)
}
