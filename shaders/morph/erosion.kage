//kage:unit pixels
package main

func Fragment(targetCoords vec4, sourceCoords vec2, color vec4, customVAs vec4) vec4 {
	const MaxThickness = 16.0
	const MaxSamples = MaxThickness*2.0 + 1.0

	thickness := customVAs[0]
	softEdge := min(customVAs[1], thickness)
	hardRadius := thickness - softEdge
	scanMin := sourceCoords - vec2(thickness)
	scanMax := sourceCoords + vec2(thickness)

	// snap both ends inwards to the fixed N + 0.5 texel-centered lattice.
	// this keeps sampling and measured distances in agreement for weighting.
	scanStart := ceil(scanMin-vec2(0.5)) + vec2(0.5)
	scanEnd := floor(scanMax-vec2(0.5)) + vec2(0.5)

	// preserve original alpha when the scan radius reaches no texel center
	alpha := imageSrc0At(sourceCoords).a

	// scan consecutive texel centers to keep the sampling grid regular.
	for y := 0.0; y < MaxSamples; y += 1.0 {
		sampleY := scanStart.y + y
		if sampleY > scanEnd.y {
			break
		}
		for x := 0.0; x < MaxSamples; x += 1.0 {
			sampleX := scanStart.x + x
			if sampleX > scanEnd.x {
				break
			}

			sampleCoords := vec2(sampleX, sampleY)
			sampleAlpha := imageSrc0At(sampleCoords).a
			dist := distance(sourceCoords, sampleCoords)
			if dist <= hardRadius {
				alpha = min(alpha, sampleAlpha)
			} else if dist < thickness {
				weight := 1.0 - smoothstep(hardRadius, thickness, dist)
				weightedAlpha := mix(1.0, sampleAlpha, weight) // 1 is neutral for min
				alpha = min(alpha, weightedAlpha)
			}
		}
	}

	return color * alpha
}
