//kage:unit pixels
package main

// This file implements a single JFA (jump flooding algorithm) pass in Kage.
// The whole algorithm consists of initialization, loop of passes and finalization.
//
// Given Ebitengine's limitations in terms of texture formats, the data for the
// JF internal maps is encoded as follows:
//  - vec4(1) represents a pixel with an unknown/max seed offset. Decoding this
//    value with jfaComputeOffsetToSeed gives a distance of (-32767, -32767). Users
//    should not be allowed to request distances beyond 32k.
//  - vec4(0) represents a seed pixel. Decoding this value with jfaComputeOffsetToSeed
//    gives a distance of (0, 0) (offset to nearest seed is zero).
//  - Otherwise the (R G B A) values are used to encode the offset to the nearest seed.
//    In particular, (R G) represents the x offset and (B A) represents the y offset.
//    The encoding is simply 16 bits: top bit represents sign (0 positive, 1 negative),
//    and the remaining 15 bits represent the magnitude. See jfaDecodeAxisOffsetToSeed
//    and jfaEncodeAxisOffsetToSeed for the actual code.

// imageSrc0 = jf map, imageSrc1 = alpha normals (optional), imageSrc2 = source

var HasNormals float

func Fragment(_ vec4, sourceCoords vec2, _ vec4, customVAs vec4) vec4 {
	pix := imageSrc0At(sourceCoords)
	if pix == vec4(0) {
		return vec4(0) // already a seed
	}

	jump := int(customVAs[0])
	maxOffset := int(customVAs[1])
	region := customVAs.zw // [minAlpha, maxAlpha], inclusive

	// like SDFs, pixels inside the region get negative distances
	fromSign := 1.0
	if within(imageSrc2UnsafeAt(sourceCoords).a, region) {
		fromSign = -1.0
	}

	bestOffset := jfaComputeOffsetToSeed(pix)
	initOffset := bestOffset
	bestDist := 65536.0 * 65536.0 // uninitialized pixels never win
	if pix != vec4(1) {
		bestDist = seedDist(sourceCoords, sourceCoords+vec2(bestOffset), fromSign, region)
	}

	offsets := [8]ivec2{
		ivec2(-jump, -jump), ivec2(0, -jump), ivec2(+jump, -jump),
		ivec2(-jump, 0), ivec2(+jump, 0),
		ivec2(-jump, +jump), ivec2(0, +jump), ivec2(+jump, +jump),
	}
	srcOrigin := imageSrc0Origin()
	srcMax := srcOrigin + imageSrc0Size() - vec2(0.001)
	for i := 0; i < 8; i++ {
		neighbor := imgSrc0AtOrWhite(sourceCoords+vec2(offsets[i]), srcOrigin, srcMax)
		if neighbor == vec4(1) {
			continue // uninitialized neighbors have no candidate
		}
		offset := jfaComputeOffsetToSeed(neighbor) + offsets[i] // our candidate best seed offset
		dist := seedDist(sourceCoords, sourceCoords+vec2(offset), fromSign, region)
		if dist < bestDist || (dist == bestDist && winTie(offset, bestOffset)) {
			bestDist = dist
			bestOffset = offset
		}
	}

	if initOffset != bestOffset && validOffsetDistance(bestOffset, maxOffset) {
		pix.xy = jfaEncodeAxisOffsetToSeed(bestOffset.x)
		pix.zw = jfaEncodeAxisOffsetToSeed(bestOffset.y)
	}
	return pix
}

// ---- shared code, see jfm_read.kage (image indices differ) ----

func seedDist(from, seed vec2, fromSign float, region vec2) float {
	// estimate from alpha: the boundary is regionOffset away from the seed's
	// center, towards from
	alpha := imageSrc2UnsafeAt(seed).a
	fromAlpha := length(from-seed) + fromSign*regionOffset(alpha, region)
	if HasNormals != 1.0 {
		return fromAlpha
	}

	// estimate with normals, when provided
	normal := imageSrc1UnsafeAt(seed)
	if normal.a == 0 {
		return fromAlpha // no normals data for this seed
	}
	// normalEdgeDist is positive on the low alpha side, which is outside the
	// region at the low alpha boundary, and inside it at the high one
	dist := fromSign * nearestBoundarySign(alpha, region) * normalEdgeDist(from, seed, normal)
	if dist < 0 {
		// the edge places from on the wrong side of the boundary, so it can't
		// be right for from (e.g., on features too thin for a reliable
		// direction)
		return fromAlpha
	}
	return dist
}

func regionOffset(alpha float, region vec2) float {
	return nearestBoundarySign(alpha, region) * (0.5 - alpha)
}

func normalEdgeDist(from, normalOrigin vec2, normal vec4) float {
	descent := normalize(normal.rg*2.0 - 1.0) // 8-bit components, normalize again
	boundaryOffset := (normal.b - 0.5) * 1.5
	fromEdge := from - (normalOrigin - descent*boundaryOffset)
	across := dot(fromEdge, descent)
	// the edge is a segment one pixel long, so corners stay round
	pastEnd := max(abs(dot(fromEdge, vec2(-descent.y, descent.x)))-0.5, 0)
	return sign(across) * sqrt(across*across+pastEnd*pastEnd)
}

func nearestBoundarySign(alpha float, region vec2) float {
	if region[1] >= 1.0 {
		return 1.0 // no high alpha boundary
	}
	if region[0] <= 0.0 {
		return -1.0 // no low alpha boundary
	}
	if abs(alpha-region[0]) <= abs(alpha-region[1]) {
		return 1.0
	}
	return -1.0
}

func within(alpha float, region vec2) bool {
	return region[0] <= alpha && alpha <= region[1]
}

// ---- end of shared code ----

func winTie(offset, bestOffset ivec2) bool {
	return (offset.x < bestOffset.x || (offset.x == bestOffset.x && offset.y < bestOffset.y))
}

func validOffsetDistance(offset ivec2, maxOffset int) bool {
	return offset.x*offset.x+offset.y*offset.y <= maxOffset*maxOffset
}

// return 1 instead of 0 when going out of bounds
func imgSrc0AtOrWhite(samplingCoords, origin, maxMinusEpsilon vec2) vec4 {
	insideBounds := min(step(origin, samplingCoords), step(samplingCoords, maxMinusEpsilon))
	outsideBounds := 1.0 - min(insideBounds.x, insideBounds.y)
	return max(imageSrc0UnsafeAt(samplingCoords), vec4(outsideBounds))
}

func jfaComputeOffsetToSeed(pix vec4) ivec2 {
	return ivec2(jfaDecodeAxisOffsetToSeed(pix.xy), jfaDecodeAxisOffsetToSeed(pix.zw))
}

// if pq is vec2(1) (max/unspecified offset), the result will be -32767
func jfaDecodeAxisOffsetToSeed(pq vec2) int {
	const epsilon = 0.001
	hi := int((pq[0] + epsilon) * 255.0)
	lo := int((pq[1] + epsilon) * 255.0)
	magnitude := ((hi & 0x7F) << 8) | lo
	sign := 1 - ((hi >> 7) << 1)
	return sign * magnitude
}

// precondition: already ensured that the offset is representable and within maxOffset bounds
func jfaEncodeAxisOffsetToSeed(offset int) vec2 {
	magnitude := abs(offset)
	negBit := (offset >> 8) & 0x80
	hi := negBit | (magnitude >> 8)
	lo := magnitude & 0xFF
	return vec2(float(hi)/255.0, float(lo)/255.0)
}
